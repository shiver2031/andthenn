{
  "name": "@andthenn/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./dist/src/index.js" },
    "./schema": { "types": "./src/schema.ts", "import": "./dist/src/schema.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude 'dist/**' --exclude 'e2e/**'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@andthenn/domain": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "embedded-postgres": "17.10.0-beta.17",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
